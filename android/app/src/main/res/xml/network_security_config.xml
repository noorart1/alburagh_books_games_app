<?xml version="1.0" encoding="utf-8"?>
<!--
  The offline content player serves downloaded books/games/quran/sound-books
  over a loopback HTTP server (see LocalContentServer) instead of file://,
  so Construct2-exported games can XHR their own assets. Only localhost
  cleartext traffic is allowed — everything else still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
